[Unit]
Description=Quipcall LiveKit SFU
After=network-online.target
Wants=network-online.target

[Service]
User=quipcall
Group=quipcall
EnvironmentFile=/opt/quipcall/secrets.env
ExecStart=/opt/quipcall/bin/livekit-server --config /opt/quipcall/livekit.yaml
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
