# Copy to deploy/auth.env.local and fill the values there; keep real credentials out of Git.
# These settings are merged into /opt/quipcall/secrets.env for deployment.
RESEND_API_KEY=
QUIPCALL_MAIL_FROM="Quipcall <login@quipcall.com>"
QUIPCALL_BOOTSTRAP_EMAIL=
# Public URL, database path and LiveKit URLs are set in the systemd unit.
# Existing LIVEKIT_API_KEY / LIVEKIT_API_SECRET / LIVEKIT_KEYS stay in secrets.env.
