# Sourced by the Makefile for local development.
QUIPCALL_BIND=127.0.0.1:8080
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=quipcall-dev
LIVEKIT_API_SECRET=quipcall-dev-secret-0123456789abcdef

# Invite-only auth, with messages written to a local outbox instead of Resend.
QUIPCALL_PUBLIC_URL=http://127.0.0.1:5173
QUIPCALL_DATABASE_URL=sqlite://dev/data/quipcall.db
QUIPCALL_MAIL_DIR=dev/data/mail
QUIPCALL_BOOTSTRAP_EMAIL=admin@example.test
LIVEKIT_API_URL=http://127.0.0.1:7880
