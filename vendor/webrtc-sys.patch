+// Quipcall patch: an extra filter after the microphone's WebRTC processing
+// (echo cancellation, gain control), and a switch for WebRTC's own noise
+// suppression on device microphones. Both are set from Rust via the C ABI.
+extern "C" {
+// `stream` identifies one APM; `channels` hold `num_frames` floats each, in
+// the 16-bit range. Called on the capture thread, every 10 ms.
+typedef void (*quipcall_capture_process_fn)(const void* stream,
+                                            float* const* channels,
+                                            size_t num_channels,
+                                            size_t num_frames,
+                                            int sample_rate_hz);
+// The APM behind `stream` is gone.
+typedef void (*quipcall_capture_release_fn)(const void* stream);
+}
+
+namespace {
+std::atomic<quipcall_capture_process_fn> quipcall_capture_process{nullptr};
+std::atomic<quipcall_capture_release_fn> quipcall_capture_release{nullptr};
+std::atomic<bool> quipcall_device_noise_suppression{true};
+
+class QuipcallCaptureProcessor : public webrtc::CustomProcessing {
+ public:
+  ~QuipcallCaptureProcessor() override {
+    if (auto release = quipcall_capture_release.load()) {
+      release(this);
+    }
+  }
+  void Initialize(int sample_rate_hz, int num_channels) override {
+    sample_rate_hz_ = sample_rate_hz;
+  }
+  void Process(webrtc::AudioBuffer* audio) override {
+    if (auto process = quipcall_capture_process.load()) {
+      process(this, audio->channels(), audio->num_channels(),
+              audio->num_frames(), sample_rate_hz_);
+    }
+  }
+  std::string ToString() const override { return "QuipcallCaptureProcessor"; }
+  void SetRuntimeSetting(webrtc::AudioProcessing::RuntimeSetting) override {}
+
+ private:
+  int sample_rate_hz_ = 0;
+};
+}  // namespace
+
+extern "C" void quipcall_set_capture_processor(
+    quipcall_capture_process_fn process,
+    quipcall_capture_release_fn release) {
+  quipcall_capture_release.store(release);
+  quipcall_capture_process.store(process);
+}
+
+// Applies to device microphone tracks created afterwards.
+extern "C" void quipcall_set_device_noise_suppression(bool enabled) {
+  quipcall_device_noise_suppression.store(enabled);
+}
+
