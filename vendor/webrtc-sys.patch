 #include "rtc_base/thread.h"
 #include "webrtc-sys/src/peer_connection.rs.h"
 #include "webrtc-sys/src/peer_connection_factory.rs.h"
+
+// Quipcall patch: an extra filter after the microphone's echo cancellation,
+// optionally followed by WebRTC's adaptive gain control (AGC2), so gain
+// follows the cleaned voice rather than the noise. Plus switches for WebRTC's
+// own noise suppression and gain control on device microphones. All set from
+// Rust via the C ABI.
+extern "C" {
+// `stream` identifies one APM; `channels` hold `num_frames` floats each, in
+// the 16-bit range. Called on the capture thread, every 10 ms, always at
+// 48 kHz: other capture rates are resampled around it.
+typedef void (*quipcall_capture_process_fn)(const void* stream,
+                                            float* const* channels,
+                                            size_t num_channels,
+                                            size_t num_frames,
+                                            int sample_rate_hz);
+// The APM behind `stream` is gone.
+typedef void (*quipcall_capture_release_fn)(const void* stream);
+}
+
+namespace {
+std::atomic<quipcall_capture_process_fn> quipcall_capture_process{nullptr};
+std::atomic<quipcall_capture_release_fn> quipcall_capture_release{nullptr};
+std::atomic<bool> quipcall_capture_gain_control{false};
+std::atomic<bool> quipcall_device_noise_suppression{true};
+std::atomic<bool> quipcall_device_gain_control{true};
+
+class QuipcallCaptureProcessor : public webrtc::CustomProcessing {
+ public:
+  // For calls: the filter and gain switch set from Rust.
+  QuipcallCaptureProcessor() = default;
+  // For offline tests: a fixed filter, called with `context` as its stream.
+  QuipcallCaptureProcessor(quipcall_capture_process_fn process,
+                           const void* context,
+                           bool gain_control)
+      : test_(true),
+        test_process_(process),
+        test_context_(context),
+        test_gain_control_(gain_control) {}
+
+  ~QuipcallCaptureProcessor() override {
+    if (auto release = quipcall_capture_release.load(); release && !test_) {
+      release(this);
+    }
+  }
+  void Initialize(int sample_rate_hz, int num_channels) override {
+    // WebRTC processes the microphone at the lower of its rate and the
+    // codec's, so 8, 16 or 32 kHz are possible. The filter (DeepFilterNet)
+    // only runs at 48 kHz, and WebRTC's own suppressor is off while it runs.
+    if (sample_rate_hz == kFilterRate) {
+      to_filter_.reset();
+      from_filter_.reset();
+    } else {
+      size_t frames = sample_rate_hz / 100;
+      to_filter_ = std::make_unique<webrtc::PushResampler<float>>(
+          frames, kFilterFrames, 1);
+      from_filter_ = std::make_unique<webrtc::PushResampler<float>>(
+          kFilterFrames, frames, 1);
+    }
+    webrtc::AudioProcessing::Config::GainController2 config;
+    config.enabled = true;
+    config.adaptive_digital.enabled = true;
+    // Telemost's setting; WebRTC's default of 6 dB/s recovers slowly.
+    config.adaptive_digital.max_gain_change_db_per_second = 12;
+    gain_control_ = std::make_unique<webrtc::GainController2>(
+        env_, config, webrtc::InputVolumeController::Config{}, sample_rate_hz,
+        num_channels, /*use_internal_vad=*/true);
+  }
+  void Process(webrtc::AudioBuffer* audio) override {
+    auto process = test_ ? test_process_ : quipcall_capture_process.load();
+    const void* stream = test_ ? test_context_ : this;
+    if (process && !to_filter_) {
+      process(stream, audio->channels(), audio->num_channels(),
+              audio->num_frames(), kFilterRate);
+    } else if (process) {
+      // The first channel, through the filter at 48 kHz and back. Channels
+      // are copies of the microphone's.
+      float* first = audio->channels()[0];
+      size_t frames = audio->num_frames();
+      to_filter_->Resample(webrtc::MonoView<const float>(first, frames),
+                           webrtc::MonoView<float>(filter_frame_, kFilterFrames));
+      float* channels[] = {filter_frame_};
+      process(stream, channels, 1, kFilterFrames, kFilterRate);
+      from_filter_->Resample(
+          webrtc::MonoView<const float>(filter_frame_, kFilterFrames),
+          webrtc::MonoView<float>(first, frames));
+      for (size_t ch = 1; ch < audio->num_channels(); ++ch) {
+        std::copy(first, first + frames, audio->channels()[ch]);
+      }
+    }
+    bool gain = test_ ? test_gain_control_
+                      : quipcall_capture_gain_control.load();
+    if (gain && gain_control_) {
+      gain_control_->Process(/*input_volume_changed=*/false, audio);
+    }
+  }
+  std::string ToString() const override { return "QuipcallCaptureProcessor"; }
+  void SetRuntimeSetting(webrtc::AudioProcessing::RuntimeSetting) override {}
+
+ private:
+  static constexpr int kFilterRate = 48000;
+  static constexpr size_t kFilterFrames = kFilterRate / 100;
+  const bool test_ = false;
+  const quipcall_capture_process_fn test_process_ = nullptr;
+  const void* const test_context_ = nullptr;
+  const bool test_gain_control_ = false;
+  webrtc::Environment env_ = webrtc::CreateEnvironment();
+  std::unique_ptr<webrtc::GainController2> gain_control_;
+  // Set when the microphone is processed at another rate than the filter's.
+  std::unique_ptr<webrtc::PushResampler<float>> to_filter_;
+  std::unique_ptr<webrtc::PushResampler<float>> from_filter_;
+  float filter_frame_[kFilterFrames] = {};
+};
+
+struct QuipcallTestApm {
+  webrtc::scoped_refptr<webrtc::AudioProcessing> apm;
+  int sample_rate_hz;
+};
+}  // namespace
+
+// `release` runs when an APM goes away; `process` may be null (no filter).
+extern "C" void quipcall_set_capture_processor(
+    quipcall_capture_process_fn process,
+    quipcall_capture_release_fn release) {
+  quipcall_capture_release.store(release);
+  quipcall_capture_process.store(process);
+}
+
+// AGC2 after the filter, from the next frame on.
+extern "C" void quipcall_set_capture_gain_control(bool enabled) {
+  quipcall_capture_gain_control.store(enabled);
+}
+
+// These apply to device microphone tracks created afterwards: WebRTC
+// re-applies a track's options on unmute and renegotiation.
+extern "C" void quipcall_set_device_noise_suppression(bool enabled) {
+  quipcall_device_noise_suppression.store(enabled);
+}
+extern "C" void quipcall_set_device_gain_control(bool enabled) {
+  quipcall_device_gain_control.store(enabled);
+}
+
+// Offline tests: an APM set up like a call's microphone on macOS (AEC3,
+// high-pass filter, NS at kHigh and AGC1 in fixed-digital mode when on; see
+// ApplyAudioProcessingOptions), with `process` as the extra filter. Mono, at
+// `sample_rate_hz` (8, 16, 32 or 48 kHz), in 10 ms frames.
+extern "C" void* quipcall_test_apm_create(int sample_rate_hz,
+                                          bool noise_suppression,
+                                          bool gain_control1,
+                                          bool gain_control2,
+                                          quipcall_capture_process_fn process,
+                                          const void* context) {
+  if (sample_rate_hz != 8000 && sample_rate_hz != 16000 &&
+      sample_rate_hz != 32000 && sample_rate_hz != 48000) {
+    return nullptr;
+  }
+  webrtc::BuiltinAudioProcessingBuilder builder;
+  builder.SetCapturePostProcessing(std::make_unique<QuipcallCaptureProcessor>(
+      process, context, gain_control2));
+  auto apm = builder.Build(webrtc::CreateEnvironment());
+  webrtc::AudioProcessing::Config config;
+  config.echo_canceller.enabled = true;
+  config.high_pass_filter.enabled = true;
+  config.noise_suppression.enabled = noise_suppression;
+  config.noise_suppression.level =
+      webrtc::AudioProcessing::Config::NoiseSuppression::Level::kHigh;
+  config.gain_controller1.enabled = gain_control1;
+  config.gain_controller1.mode =
+      webrtc::AudioProcessing::Config::GainController1::kFixedDigital;
+  apm->ApplyConfig(config);
+  return new QuipcallTestApm{apm, sample_rate_hz};
+}
+
+// One frame: `render` is what the speaker plays, `capture` the microphone,
+// processed in place.
+extern "C" int quipcall_test_apm_process(void* apm,
+                                         const int16_t* render,
+                                         int16_t* capture) {
+  auto& test = *static_cast<QuipcallTestApm*>(apm);
+  webrtc::StreamConfig config(test.sample_rate_hz, 1);
+  int16_t played[480];
+  if (int err = test.apm->ProcessReverseStream(render, config, config, played)) {
+    return err;
+  }
+  test.apm->set_stream_delay_ms(0);
+  return test.apm->ProcessStream(capture, config, config, capture);
+}
+
+extern "C" void quipcall_test_apm_destroy(void* apm) {
+  delete static_cast<QuipcallTestApm*>(apm);
+}
 
